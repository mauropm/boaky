# Boaky configuration (all optional — safe defaults are compiled in).
# Copy to .env and adjust; .env is gitignored and never baked into images.

# --- Paths (defaults shown; override for non-Docker use) ---
BOAKY_BOOKS_DIR=./books
BOAKY_DB_PATH=./data/index/boaky.db
BOAKY_META_DIR=./data/metadata

# --- Passage splitting (runes) ---
# Target max passage size; overlap keeps split sentences findable.
BOAKY_PASSAGE_MAX_RUNES=2500
BOAKY_PASSAGE_OVERLAP_RUNES=250

# --- Indexing ---
BOAKY_INDEX_BATCH_SIZE=500
BOAKY_MAX_FILE_BYTES=67108864

# --- Search / retrieval ---
BOAKY_SEARCH_LIMIT=10
BOAKY_MAX_HITS_PER_BOOK=3
BOAKY_MAX_CONTEXT_CHARS=12000

# --- Evidence gate (lexical signals; not semantic proof) ---
# A question needs: at least MIN_RESULTS passages, top score >= MIN_SCORE
# (once the corpus is big enough for BM25 idf to mean anything, see
# MIN_PASSAGES_FOR_SCORE), and >= MIN_COVERAGE of its content words present.
BOAKY_EVIDENCE_MIN_RESULTS=1
BOAKY_EVIDENCE_MIN_SCORE=2.5
BOAKY_EVIDENCE_MIN_COVERAGE=0.60
BOAKY_EVIDENCE_PARTIAL_COVERAGE=0.30
BOAKY_EVIDENCE_MIN_PASSAGES_FOR_SCORE=50

# --- SQLite ---
BOAKY_DB_POOL_SIZE=4

# --- HTTP MCP server (serve-http) ---
BOAKY_HTTP_ADDR=127.0.0.1:8000

# --- Logging ---
# debug | info | warn | error
BOAKY_LOG_LEVEL=info

# --- Generation (only used by `boaky answer`; leave unset to run
# evidence-only. Hermes normally does the generation.) ---
# Never put real keys in git. The key stays in your shell/container env.
# BOAKY_GEN_BASE_URL=https://opencode.ai/zen/go/v1
# BOAKY_GEN_MODEL=deepseek-chat
# BOAKY_GEN_API_KEY=
